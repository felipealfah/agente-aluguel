PORT=3333
DATABASE_URL=./data/agente.db
FRONT_ORIGIN=http://localhost:3000

# --- Opcionais -------------------------------------------------------------
# Chave da API da Anthropic (https://console.anthropic.com). Com ela, o Claude
# valida cada anúncio (região, tipo, aluguel residencial) e escreve o motivo no
# card. Sem ela, a validação é feita só por regras. NUNCA faça commit deste arquivo
# preenchido: o .env já está no .gitignore.
ANTHROPIC_API_KEY=

# Modelo usado na análise. Padrão: claude-opus-5-5. Para gastar menos, experimente
# claude-sonnet-5-5 (a qualidade da análise muda; compare antes de adotar).
# ANTHROPIC_MODEL=claude-opus-5-5

# Caminho do CLI do Ego Lite, se o comando "ego-browser" não estiver no PATH.
# EGO_BROWSER_BIN=ego-browser
